# ignore all target and delombok directories in the modules
**/target/**
**/delombok/
# ignore buildnumber counters
**/buildNumber.properties
# ignore toplevel target
target/
## publication safety.
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.mvn/*
# Avoid ignoring Maven wrapper jar file (.jar files are usually ignored)
!/.mvn/wrapper/maven-wrapper.jar
/.idea/
/__local/
/.output.txt
/*.log